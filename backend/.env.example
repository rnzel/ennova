# ENNOVA (Alaala) – Team members: [Full name] – Front End; [Full name] – Back End; [Full name] – Q/A; [Full name] – UI/UX Designer; [Full name] – Documentator
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=
APP_TIMEZONE=UTC
MAX_CONTENT_LENGTH=1048576
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
AIVEN_CA_PATH=C:/path/to/ca.pem
SWIPL_EXECUTABLE=swipl
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QUESTION_TIMEOUT_SECONDS=45
RUN_LIVE_AI_TESTS=0
