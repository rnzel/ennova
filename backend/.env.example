# ENNOVA (Alaala) – Team members: [Full name] – Front End; [Full name] – Back End; [Full name] – Q/A; [Full name] – UI/UX Designer; [Full name] – Documentator
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=mysql+pymysql://user:password@host:3306/ennova
AIVEN_CA_PATH=
SWIPL_EXECUTABLE=swipl
LLM_PROVIDER=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_ALLOW_REMOTE=0
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_QUESTION_TIMEOUT_SECONDS=45
OLLAMA_CONNECT_TIMEOUT_SECONDS=15
OLLAMA_READ_TIMEOUT_SECONDS=30
OLLAMA_MAX_RESPONSE_BYTES=1048576
RUN_LIVE_AI_TESTS=0
